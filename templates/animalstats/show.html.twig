 {% extends 'base.html.twig' %}

{% block title %}
    Statistiques Animaux vues
{% endblock %}

{% block body %}
    <h1>Animaux</h1>
        {% for animalstat in animalstats %}
            <p>
                <span style="color:deeppink;"><b>Name: </b>{{ animalstat.name }}</span><br>
                <b>Espèce:</b> {{ animalstat.animal }}<br>
                <b>Id:</b> {{ animalstat.animal_id }}<br>
                <b>Views:</b> {{ animalstat.views }}<br>  
            </p>
        {% endfor %}

        <div class="container">
    <div class="row text-center">
        <h2 class="display-4 fw-bold my-5 py-5">Découvrir les animaux de cet habitat</h2>
        {% for animals in animals %}
        {% include "partials/_test.card.animals.html.twig" %}
        {% endfor %}
    </div>
</div>
{% endblock %}