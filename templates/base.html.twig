<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Zoo Arcadia{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
  <style>
:root {
    --arcadia-dark: #06211F;
    --shadow-arcadia-dark: 0px 50px 100px 150px #06211F;
}
.bg-arcadia-dark { 
    background-color: var(--arcadia-dark) !important;
    background-image: linear-gradient(#06211F, #245C58, #06211F);
}
.shadow-arcadia-dark { 
    box-shadow: var(--shadow-arcadia-dark) !important; 
}
</style>
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}                 
        {% endblock %}

        
    </head>
    <body>

        {% include '/partials/_header.html.twig' %}


        <div class="m-0 p-0">
            {% block body %}{% endblock %}
        </div>
        
        {% include '/partials/_footer.html.twig' %}
    </body>
</html>
