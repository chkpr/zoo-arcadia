<div class="col-md-4 my-2 d-flex">
    <div class="card w-100">
    {% if habitat.imageName %}
        <img src="{{ vich_uploader_asset(habitat, 'imageFile') }}" class="card-img-top" alt="photo de {{ habitat.name }}">
    {% else %}
        <img src="{{ asset('build/images/default-habitat.png') }}" class="card-img-top" alt="photo de {{ habitat.name }}">
    {% endif %}
    <div class="card-body">
        <h5 class="card-title">{{ habitat.name }}</h5>
        <a href="{{ path('app_habitats_show', {'id': habitat.id}) }}" class="btn btn-primary">Découvrir</a>
    </div>
    </div>
</div>