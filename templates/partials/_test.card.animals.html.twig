<div class="col-md-4 my-2 d-flex">
    <div class="card w-100">
    {% if animals.imageName %}
        <img src="{{ vich_uploader_asset(animals, 'imageFile') }}" class="card-img-top" alt="photo de {{ animals.name }}">
    {% else %}
        <img src="{{ asset('build/images/default-habitat.png') }}" class="card-img-top" alt="photo de {{ animals.name }}">
    {% endif %}
    <div class="card-body">
        <h5 class="card-title">{{ animals.name }}</h5>
        <a href="{{ path('app_animals_habitat', {habitat: animals.habitat}) }}" class="btn btn-primary">Découvrir</a>
    </div>
    </div>
</div>