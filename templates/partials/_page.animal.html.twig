{% extends 'base.html.twig' %}

{% block title %}{{animal.name}}{% endblock %}

{% block body %}

<div class="d-flex align-items-end">
    <div class="position-absolute d-flex flex-column align-items-start pb-5 mb-3 ps-5 ms-5">
        <h1 class="display-3 fw-bold text-light">{{animal.name}}</h1>
            <div class="container">
                <h2 class="display-6 fw-bold text-light">{{animal.description}}</h2>
                    <div class="">
                        <a href="{{ path('app_habitats_show', {'id': animal.habitat.id}) }}" class="btn btn-primary">Retour</a>
                        
                    </div>
            </div>
    </div>

    {% if animal.imageName %}
        <img src="{{ vich_uploader_asset(animal, 'imageFile') }}" class="w-100 h-100 img-fluid" alt="{{animal.name}}">
    {% else %}
        <img src="{{ asset('build/images/default-habitat.png') }}" class="card-img-top" alt="Photo manquante">
    {% endif %}

</div>

{% endblock %}