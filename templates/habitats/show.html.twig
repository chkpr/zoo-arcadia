{% extends 'base.html.twig' %}

{% block title %}{{habitat.name}}{% endblock %}

{% block body %}

<div class="d-flex align-items-end">
    <div class="position-absolute d-flex flex-column align-items-start pb-5 overlay">
        <h1 class="display-3 fw-bold text-light ps-5 ms-5 z-50">{{habitat.name}}</h1>
            <div class="">
                <h2 class="display-6 fw-bold text-light px-5 mx-5 z-50">{{habitat.description}}</h2>
                    <div class="ps-5 ms-5 z-50">
                        <a href="{{ path('app_habitats_show', {'id': habitat.id}) }}#decouvrir" class="btn btn-primary">Découvrir</a>
                        
                    </div>
            </div>
    </div>

    {% if habitat.imageName %}
        <img src="{{ vich_uploader_asset(habitat, 'imageFile') }}" class="w-100 h-100 img-fluid" alt="{{habitat.name}}">
    {% else %}
        <img src="{{ asset('build/images/default-habitat.png') }}" class="card-img-top" alt="Photo manquante">
    {% endif %}

</div>

<div class="container">
    <div class="row text-center">
        <h2 class="display-4 fw-bold my-5 py-5">Découvrir les animaux de cet habitat</h2>

    </div>
</div>

    {% if habitat.id == 1 %}
    <div class="container">
    <div class="row text-center" id="decouvrir">
        
        {% for animal in animals %}
        {% include "partials/_card.animal.html.twig" %}
        {% endfor %}
        
    </div>
    


    {% elseif habitat.id == 2 %}
    <div class="container">
    <div class="row text-center" id="decouvrir">
        
        {% for animal in animals %}
        {% include "partials/_card.animal.html.twig" %}
        {% endfor %}
        
    </div>
    

    {% elseif habitat.id == 3 %}
    <div class="container">
    <div class="row text-center" id="decouvrir">
        
        {% for animal in animals %}
        {% include "partials/_card.animal.html.twig" %}
        {% endfor %}
        
    </div>
    

    {% endif %}

{% endblock %}