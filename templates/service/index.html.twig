{% extends 'base.html.twig' %}

{% block title %}Services{% endblock %}

{% block body %}

<div class="d-flex align-items-end">
    <div class="position-absolute d-flex flex-column align-items-start pb-5 mb-3 ps-5 ms-5">
        <h1 class="display-3 fw-bold text-light">Services</h1>
            <div class="">
                <h2 class="display-6 fw-bold text-light">Découvrez tous les services du zoo Arcadia pour organiser votre visite.</h2>
                    <div class="">
                        <button type="button" class="btn btn-primary btn-lg px-4 gap-3">Découvrir</button>
                        
                    </div>
            </div>
    </div>

    <img src="{{ asset ('build/images/cover_services.png')}}" class="w-100 h-100 img-fluid" alt="Un guépard allongé dans un arbre vu en gros plan">

  </div>

<div class="container">
    <div class="row text-center">
        <h2 class="display-4 fw-bold my-5 py-5">Services</h2>
        {% for service in services %}
        {% include "partials/_section.services.html.twig" %}
        {% endfor %}
    </div>
</div>

{% endblock %}
