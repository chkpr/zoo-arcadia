{% extends 'base.html.twig' %}

{% block title %}{{service.name}}{% endblock %}

{% block body %}

<div class="d-flex align-items-end">
    <div class="position-absolute d-flex flex-column align-items-start pb-5 mb-3 ps-5 ms-5">
        <h1 class="display-3 fw-bold text-light">{{service.name}}</h1>
            <div class="">
                <h2 class="display-6 fw-bold text-light">{{service.description}}</h2>
                    <div class="">
                        <button type="button" class="btn btn-primary btn-lg px-4 gap-3">Découvrir</button>
                        
                    </div>
            </div>
    </div>

    {% if service.imageName %}
        <img src="{{ vich_uploader_asset(service, 'imageFile') }}" class="w-100 h-100 img-fluid" alt="{{service.name}}">
    {% else %}
        <img src="{{ asset('build/images/default-service.png') }}" class="card-img-top" alt="Photo manquante">
    {% endif %}

</div>

<div class="container">
    <div class="row text-center">
        <h2 class="display-4 fw-bold my-5 py-5">{{ service.name }}</h2>
        <p>{{ service.OpeningHours }}</p>

    </div>
</div>


{% endblock %}